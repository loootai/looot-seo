# Demo mode: seeded data, no Supabase, no looot token. Set to 1 and nothing else is needed.
NEXT_PUBLIC_DEMO=

# Supabase project (Project settings, API). Both values are public; row level security protects the rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Who may use the workspace. Set at least one, or the app shows a setup page and refuses everything.
LOOOT_SEO_ALLOWED_EMAILS=
LOOOT_SEO_ALLOWED_DOMAINS=
# Optional ceiling for one run, in dollars.
LOOOT_SEO_MAX_RUN_USD=

# looot token from https://looot.ai. Server only. Never prefix it with NEXT_PUBLIC_.
LOOOT_TOKEN=
